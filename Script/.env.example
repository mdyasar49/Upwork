# Environment configuration for Upwork Lead Scraper
# Copy to Script/.env and fill in values.

# Google Sheets Configuration
GOOGLE_SHEET_ID=1qLxmNGGeuFuXnQnH4ITtnEGdaUpfzquIaf7wDHJpdD0
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json

# Upwork Search Configuration
UPWORK_BASE_SEARCH_URL=https://www.upwork.com/nx/search/jobs/
DEFAULT_LOCATIONS=Australia,India
DEFAULT_SORT=recency
KEYWORDS_CSV=input/upwork_keywords.csv

# Batch Limits & Pagination
DAILY_SCRAPE_LIMIT=50
MAX_PAGES_PER_KEYWORD=5
PAGE_SLEEP_MIN=4
PAGE_SLEEP_MAX=8

# CRM Sheet Defaults
LEAD_SOURCE=Upwork
LEAD_STATUS=New
LEAD_ADDED_BY=Upwork Scraper
CRM_SYNCED_DEFAULT=Pending

# Filtering Rules
REQUIRE_EMAIL_OR_PHONE=false
FILTER_KEYWORDS_ENABLED=true

# MongoDB Configuration (Optional)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=upwork_db
MONGO_JOBS_COLLECTION=jobs
MONGO_PROFILES_COLLECTION=profiles

# Execution Options
HEADLESS=true
SKIP_GOOGLE_SHEETS=false
# CHROMEDRIVER_PATH=
